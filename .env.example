# ברירת המחדל עובדת כמו שהיא — אין חובה לגעת בקובץ הזה בפיתוח מקומי.

# --- מסד הנתונים: Postgres בכל הסביבות (docs/DECISIONS.md סעיף 20) ---
# פיתוח מקומי: מריצים `pnpm db:local` בטרמינל נפרד — Postgres מקומי בלי התקנה.
DATABASE_URL="postgres://postgres@127.0.0.1:5433/postgres"
# בענן: כתובת ה-Postgres המנוהל. רוב הספקים דורשים sslmode, למשל:
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# --- שכבת הכניסה (סיסמה יחידה) ---
# חובה בכל סביבה חשופה לרשת. בלעדיה השרת בפרודקשן מסרב לענות (503).
# בפיתוח מקומי בלי הערך הזה — האפליקציה פתוחה, כמו שהייתה.
# APP_PASSWORD="בחר-סיסמה-ארוכה"
# רשות: מפתח חתימה לעוגיית הכניסה. בלעדיו החתימה נגזרת מהסיסמה,
# ולכן החלפת סיסמה מנתקת מיד את כל המכשירים.
# AUTH_SECRET="מחרוזת-אקראית-ארוכה"

# --- פיילוט ציבורי (החלטה 35) ---
# שם המפעיל כפי שיופיע בתנאי השימוש, במדיניות הפרטיות ובפוטר של העמודים
# הציבוריים. אדם פרטי, לא חברה. בלי הערך הזה המסמכים כותבים "מפעיל האפליקציה".
# OPERATOR_NAME="שם מלא"
# כתובת לפניות משתמשים. רשות: בלעדיה המסמכים מפנים לטופס שב-/contact בלבד.
# אותה כתובת צריכה להופיע גם במסך ההסכמה של גוגל (docs/legal/google-consent-screen.md).
# SUPPORT_EMAIL="you@example.com"
# הכתובת הציבורית של האפליקציה — ממנה נגזרים metadataBase, robots.txt,
# sitemap.xml וכתובות ה-OG. בלעדיה נופלים לכתובת ה-Railway הנוכחית.
# APP_URL="https://hamenoa-production.up.railway.app"
# כמה קפיצות פרוקסי שלנו יושבות בקצה הימני של x-forwarded-for. הגבלת הקצב
# לוקחת את הכתובת מהקצה הימני (הערכים השמאליים הם מה שהלקוח שלח בעצמו),
# ובניכוי מספר הקפיצות הזה. ‏Railway היום = 0; שכבת CDN נוספת תדרוש 1.
# TRUSTED_PROXY_HOPS="0"

# --- ארכיון מקורות תוכן: משותף לכל תיקיות העבודה, מחוץ לגיט ---
# הנתיב נפתר יחסית לתיקיית הפרויקט. ברירת המחדל:
# CONTENT_ARCHIVE_DIR="../storage/content-sources"
# יעד גיבוי נוסף בבעלותך: כונן חיצוני או תיקייה מסונכרנת. אין יעד מוגדר מראש.
# CONTENT_BACKUP_MIRROR="/path/to/your/backup-folder"
